rules_version = '2';

// ============================================================================
// Berry Source SaaS - aislamiento por empresa
//
// Modelo de datos:
//   /companies/{companyId}                -> ficha de la empresa
//   /companies/{companyId}/<COLECCION>    -> TODOS los datos de esa empresa
//   /system_users/{uid}                   -> global: email, roleId, companyId
//
// Regla de oro: un usuario solo puede leer o escribir bajo el companyId que
// tiene grabado en su documento de system_users. La ruta hace imposible el
// cruce de informacion incluso si el cliente pidiera otra coleccion.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Documento del usuario que hace la peticion (id del doc = uid de Auth).
    function me() {
      return get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data;
    }

    function myProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/system_users/$(request.auth.uid));
    }

    function isActive() {
      return myProfileExists() && me().status != 'Inactive';
    }

    // Administrador de la plataforma (crea empresas y migra datos).
    // Se reconoce por el flag en su perfil O por email, para que el dueno del
    // SaaS nunca quede bloqueado fuera de su propia plataforma.
    function isPlatformAdminEmail() {
      return signedIn() && request.auth.token.email in ['jesuslevinole@gmail.com'];
    }

    function isPlatformAdmin() {
      return isPlatformAdminEmail()
        || (myProfileExists() && me().isPlatformAdmin == true);
    }

    // El usuario pertenece a esa empresa.
    function belongsTo(companyId) {
      return isActive() && me().companyId == companyId;
    }

    // ---- Empresas ---------------------------------------------------------

    match /companies/{companyId} {
      // La ficha (incluida la suscripcion: trial, pagos, exempt) la LEE quien
      // pertenece a la empresa, pero solo la plataforma la crea o modifica:
      // ninguna empresa puede extenderse su propia prueba ni marcarse pagada.
      allow read: if belongsTo(companyId) || isPlatformAdmin();

      // Auto-registro: cualquier usuario autenticado puede crear SU empresa,
      // pero nunca exenta ni con periodo pagado: eso solo lo otorga la plataforma.
      allow create: if isPlatformAdmin()
        || (
          signedIn()
          && request.resource.data.exempt != true
          && !('paidThrough' in request.resource.data)
          && request.resource.data.status == 'Active'
        );

      // La suscripcion (trial, pagos, exencion) solo la modifica la plataforma.
      allow update, delete: if isPlatformAdmin();

      // ---- TODOS los datos de negocio de la empresa ----
      // Compras, ventas, gastos, catalogos, cheques, roles, configuracion,
      // historial de actividad y papelera cuelgan de aqui.
      match /{document=**} {
        allow read, write: if belongsTo(companyId) || isPlatformAdmin();
      }
    }

    // ---- Usuarios del sistema (global, pero acotado por empresa) -----------

    match /system_users/{userId} {
      // Cada quien lee su propio perfil (necesario para resolver su empresa)
      // y los perfiles de su misma empresa.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isPlatformAdmin()
          || (myProfileExists() && resource.data.companyId == me().companyId)
        );

      // Alta de usuarios: dentro de la propia empresa, o el perfil propio al
      // registrarse (auto-registro: el dueno crea su primer usuario).
      allow create: if isPlatformAdmin()
        || (isActive() && request.resource.data.companyId == me().companyId)
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.isPlatformAdmin != true
          && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        );

      // Edicion y baja: el usuario no puede cambiarse de empresa a si mismo.
      // Nadie se cambia de empresa ni se asciende a admin de plataforma a si mismo.
      allow update: if isPlatformAdmin()
        || (
          isActive()
          && resource.data.companyId == me().companyId
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.isPlatformAdmin != true
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.isPlatformAdmin != true
        );

      allow delete: if isPlatformAdmin()
        || (isActive() && resource.data.companyId == me().companyId);
    }

    // ---- Colecciones legadas en la raiz -----------------------------------
    // Solo el admin de la plataforma las alcanza, para poder ejecutar la
    // migracion (Companies -> Import legacy data). Ningun usuario de empresa
    // puede leerlas ni escribirlas.
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
