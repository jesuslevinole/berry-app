rules_version = '2';

// ============================================================================
// Berry Source SaaS - aislamiento por empresa
//
// Modelo de datos:
//   /companies/{companyId}                -> ficha de la empresa
//   /companies/{companyId}/<COLECCION>    -> TODOS los datos de esa empresa
//   /system_users/{uid}                   -> global: email, roleId, companyId
//
// Regla de oro: un usuario solo puede leer o escribir bajo el companyId que
// tiene grabado en su documento de system_users. La ruta hace imposible el
// cruce de informacion incluso si el cliente pidiera otra coleccion.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Documento del usuario que hace la peticion (id del doc = uid de Auth).
    function me() {
      return get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data;
    }

    function myProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/system_users/$(request.auth.uid));
    }

    // 'Pending Approval' = dueno de una empresa recien registrada que la
    // plataforma aun no aprueba: todavia no entra a los datos de la empresa.
    function isActive() {
      return myProfileExists()
        && me().status != 'Inactive'
        && me().status != 'Pending Approval';
    }

    // Administrador de la plataforma (Admin Panel: crea empresas, suscripciones).
    // Por email: los duenos fijos (misma lista que PLATFORM_ADMIN_EMAILS en
    // services/tenant.ts) o los agregados en platform_admins/{email}. Exige el
    // email verificado: si no, cualquiera podria crear una cuenta con ese correo.
    function isPlatformOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['jesuslevinole@gmail.com', 'mdo.cesar@gmail.com'];
    }

    function isPlatformAdminEmail() {
      return isPlatformOwner()
        || (
          signedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/platform_admins/$(request.auth.token.email))
        );
    }

    function isPlatformAdmin() {
      return isPlatformAdminEmail()
        || (myProfileExists() && me().isPlatformAdmin == true);
    }

    // Membresia secundaria: el mismo email invitado a otra empresa se guarda
    // como system_users/{uid}__{companyId}.
    function membershipPath(companyId) {
      return /databases/$(database)/documents/system_users/$(request.auth.uid + '__' + companyId);
    }

    function hasMembership(companyId) {
      return signedIn()
        && exists(membershipPath(companyId))
        && get(membershipPath(companyId)).data.status != 'Inactive'
        && get(membershipPath(companyId)).data.status != 'Pending Approval';
    }

    // El usuario pertenece a esa empresa: por su perfil principal o por una
    // membresia creada por esa empresa al invitarlo.
    function belongsTo(companyId) {
      return (isActive() && me().companyId == companyId) || hasMembership(companyId);
    }

    function companyCard(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    // Quien registro la empresa, mientras la plataforma no la aprueba.
    function isPendingOwner(companyId) {
      return signedIn()
        && companyCard(companyId).status == 'Pending'
        && companyCard(companyId).get('ownerUid', '') == request.auth.uid;
    }

    // ---- Empresas ---------------------------------------------------------

    match /companies/{companyId} {
      // La ficha (incluida la suscripcion: trial, pagos, exempt) la LEE quien
      // pertenece a la empresa, pero solo la plataforma la crea o modifica:
      // ninguna empresa puede extenderse su propia prueba ni marcarse pagada.
      // Su dueno tambien la lee mientras espera la aprobacion.
      allow read: if belongsTo(companyId)
        || isPlatformAdmin()
        || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);

      // Auto-registro: cualquier usuario autenticado puede crear SU empresa, pero
      // nace 'Pending' (la plataforma la aprueba) y nunca exenta ni pagada.
      allow create: if isPlatformAdmin()
        || (
          signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'Pending'
          && request.resource.data.get('exempt', false) != true
          && !('paidThrough' in request.resource.data)
        );

      // La suscripcion (trial, pagos, exencion) solo la modifica la plataforma.
      allow update, delete: if isPlatformAdmin();

      // ---- TODOS los datos de negocio de la empresa ----
      // Compras, ventas, gastos, catalogos, cheques, roles, configuracion,
      // historial de actividad y papelera cuelgan de aqui.
      match /{document=**} {
        allow read, write: if belongsTo(companyId) || isPlatformAdmin();
      }

      // Empresa pendiente: el dueno solo prepara su rol y su ficha (registro).
      match /settings_roles/{roleId} {
        allow read, write: if isPendingOwner(companyId);
      }
      match /settings_company/{docId} {
        allow read, write: if isPendingOwner(companyId);
      }
    }

    // ---- Usuarios del sistema (global, pero acotado por empresa) -----------

    match /system_users/{userId} {
      // Cada quien lee su propio perfil (necesario para resolver su empresa)
      // y los perfiles de su misma empresa.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isPlatformAdmin()
          || (myProfileExists() && resource.data.companyId == me().companyId)
        );

      // Alta de usuarios: dentro de la propia empresa, o el perfil propio al
      // registrarse (auto-registro: el dueno crea su primer usuario, en espera,
      // y solo en la empresa pendiente que el mismo acaba de crear).
      allow create: if isPlatformAdmin()
        || (isActive() && request.resource.data.companyId == me().companyId)
        || (isActive() && hasMembership(request.resource.data.companyId))
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.get('isPlatformAdmin', false) != true
          && request.resource.data.status == 'Pending Approval'
          && isPendingOwner(request.resource.data.companyId)
        );

      // Edicion y baja: el usuario no puede cambiarse de empresa a si mismo.
      // Nadie se cambia de empresa ni se asciende a admin de plataforma a si mismo.
      allow update: if isPlatformAdmin()
        || (
          isActive()
          && resource.data.companyId == me().companyId
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.isPlatformAdmin != true
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('isPlatformAdmin', false) != true
        );

      allow delete: if isPlatformAdmin()
        || (isActive() && resource.data.companyId == me().companyId);
    }

    // ---- Administradores de la plataforma ----------------------------------
    // Los ven los administradores; solo los duenos fijos (isPlatformOwner, que
    // no se pueden quitar) agregan o quitan administradores.
    match /platform_admins/{email} {
      // Cada quien puede ver si su propio email fue agregado (para pedirle que lo verifique).
      allow read: if isPlatformAdmin()
        || (signedIn() && request.auth.token.email == email);
      allow write: if isPlatformOwner();
    }

    // ---- Historial de pagos de suscripcion (dashboard de ingresos) ---------
    // Global y solo de la plataforma: ninguna empresa ve lo que pagan las demas.
    match /platform_payments/{paymentId} {
      allow read, write: if isPlatformAdmin();
    }

    // ---- Planes y precios (seccion Pricing de la landing) ------------------
    // Publicos para leer (la landing los muestra sin sesion); solo la plataforma los edita.
    match /platform_plans/{planId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ---- Colecciones legadas en la raiz -----------------------------------
    // Solo el admin de la plataforma las alcanza, para poder ejecutar la
    // migracion (Companies -> Import legacy data). Ningun usuario de empresa
    // puede leerlas ni escribirlas.
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
