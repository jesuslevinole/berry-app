{
  // Worker que sirve Berry (dist/) y la API de correo (/api/send-email).
  // El nombre debe coincidir con el Worker existente: berry-app.jesuslevinole.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "berry-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Dominios propios de la app (se conservan en cada deploy). La zona de cada dominio
  // debe estar activa en Cloudflare; itgresults.com raiz sigue siendo la pagina de Wix.
  "routes": [
    { "pattern": "app.berry-source.com", "custom_domain": true },
    { "pattern": "app.itgresults.com", "custom_domain": true }
  ],
  // Mantener tambien berry-app.jesuslevinole.workers.dev y las URLs de vista previa.
  "workers_dev": true,
  "preview_urls": true,
  // Logs del Worker en el panel de Cloudflare (Observability).
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa por el codigo del Worker; el resto se sirve directo como estatico.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "berry-app-7021e",
    // Remitente (dominio verificado en Resend).
    "MAIL_FROM": "Berry Source <noreply@berrysource.com>",
    // Square (cobro de suscripciones). No son secretos: el formulario de tarjeta los usa en
    // el navegador y el app los pide al Worker. Al pasar a produccion: "production" y los IDs
    // de Production (el token tambien se cambia, con wrangler secret put).
    "SQUARE_ENV": "sandbox",
    "SQUARE_APPLICATION_ID": "sandbox-sq0idb-uoIz3JPD8GyR8HElRF61Yg",
    "SQUARE_LOCATION_ID": "LCD8G4SJFTBY8",
    // URL del webhook EXACTAMENTE como se registra en Square (Developer Console > Webhooks):
    // entra en la firma de cada aviso; si no coincide, el Worker los rechaza.
    "SQUARE_WEBHOOK_URL": "https://berry-app.jesuslevinole.workers.dev/api/billing/webhook"
  }
  // Secrets (no van aqui), con npx wrangler secret put <NOMBRE>:
  //   RESEND_API_KEY, SQUARE_ACCESS_TOKEN, SQUARE_WEBHOOK_SIGNATURE_KEY, FIREBASE_SERVICE_ACCOUNT
}
